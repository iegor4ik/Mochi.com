# M-o-chi.com — настройки окружения (server/)
PORT=3000

# Подключение к PostgreSQL (локально через Docker: host=localhost, порт 5433)
DATABASE_URL=postgres://

# Секрет для подписи JWT (ОБЯЗАТЕЛЬНО сменить в продакшене; тот же у game-server!)
JWT_SECRET=change-me-super-secret-in-production

# Загрузки
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Ключ внутреннего эндпоинта /api/internal/* (для игрового сервера).
# Если пусто — проверка ключа выключена; иначе game-server обязан слать X-Internal-Key.
INTERNAL_API_KEY=
