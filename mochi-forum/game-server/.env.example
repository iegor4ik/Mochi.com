# Игровой сервер «Хаб» (M-o-chi.com) — настройки окружения
PORT=3001

# БД игры — ОТДЕЛЬНЫЙ Postgres (Docker, хост-порт 5434)
DATABASE_URL=postgres://mochi_game:game_secret@localhost:5434/mochi_game

# Тот ЖЕ секрет JWT, что у основного сайта (см. server/.env) — иначе игроки получат 401
JWT_SECRET=change-me-super-secret-in-production

# Основной API (откуда берутся профили пользователей)
MAIN_API_URL=http://localhost:3000

# Ключ внутреннего эндпоинта основного сервера (заголовок X-Internal-Key).
# Значение должно совпадать с INTERNAL_API_KEY в server/.env; если пусто — проверка ключа выключена.
INTERNAL_API_KEY=

# Тесты (game-server/scripts/test-*.js) — необязательные переменные:
# TEST_LOGIN / TEST_PASSWORD   — аккаунт форума для теста WS
# TEST_LOGIN2 / TEST_PASSWORD2 — второй аккаунт (по умолчанию sakura/sakura123)
