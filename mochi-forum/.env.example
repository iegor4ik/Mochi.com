# M-o-chi.com — настройки окружения
PORT=3000

# Подключение к PostgreSQL (локально через Docker: host=localhost)
DATABASE_URL=postgres://mochi:mochi_secret@localhost:5432/mochi

# Секрет для подписи JWT (ОБЯЗАТЕЛЬНО сменить в продакшене)
JWT_SECRET=change-me-super-secret-in-production

# Загрузки
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5